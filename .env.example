# Set these in the frontend build environment for production.
# Use sibling subdomains of the same registrable domain (for example app.example.com + api.example.com)
# so the API's secure, HttpOnly, SameSite=Lax cookie works for REST and Socket.IO.
NEXT_PUBLIC_API_URL=https://api.example.com/api
NEXT_PUBLIC_CHAT_SOCKET_URL=https://api.example.com
